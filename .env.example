# Copy to .env and adjust. Read by docker-compose.yml and by
# backend/config/settings via python-decouple.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-every-real-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Postgres ---
POSTGRES_DB=content_pipeline
POSTGRES_USER=content_pipeline
POSTGRES_PASSWORD=content_pipeline
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Django cache (throttling, dedupe window) — separate DB index from the
# Celery broker above so their keyspaces never collide.
CACHE_REDIS_URL=redis://redis:6379/1

# --- CORS / CSRF (React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- Error tracking (optional) ---
# Leave SENTRY_DSN blank to disable entirely (default) — settings.py only
# calls sentry_sdk.init() when it's set.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Flower (Celery monitoring UI, optional basic auth) ---
FLOWER_BASIC_AUTH=admin:changeme
