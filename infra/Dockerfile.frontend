# Dev image: runs the Vite dev server with hot reload against a bind mount.
# A separate production build (static export served via nginx or the
# backend's staticfiles) is out of scope until closer to deployment.
FROM node:20-slim

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ .

EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
